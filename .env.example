# Notification System - Local/Dev environment template
# Copy this file to `.env` and adjust values for local development.
# Do NOT commit `.env` or any file containing real secrets/credentials.
# Docker Compose (docker/docker-compose.yml) can load variables from `../.env` (optional) and uses defaults when unset.

# Application
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=notification
DB_USER=postgres
DB_PASSWORD=postgres
ConnectionStrings__Database=Host=postgres;Port=5432;Database=notification;Username=postgres;Password=postgres

# JWT (dev-only sample values; replace for non-local environments)
JWT_ISSUER=notification-system-dev
JWT_AUDIENCE=notification-system-dev
JWT_SIGNING_KEY=dev-only-change-this-signing-key-min-32-chars-000000

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# SMTP / Email (Mailpit for local dev)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@notification.local
SMTP_ENABLE_SSL=false

# OpenTelemetry (observability - tracing/metrics)
# OTLP endpoint example for local collector: http://otel-collector:4317 (gRPC) or http://otel-collector:4318 (HTTP/protobuf)
OpenTelemetry__Enabled=true
OpenTelemetry__Tracing__Enabled=true
OpenTelemetry__Metrics__Enabled=true
OpenTelemetry__Exporter__Otlp__Endpoint=
OpenTelemetry__Exporter__Otlp__Protocol=Grpc
OpenTelemetry__Exporter__Console__Enabled=false
