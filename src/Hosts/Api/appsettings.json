{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "NotificationSystem.Api",
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    },
    "Exporter": {
      "Otlp": {
        "Endpoint": "",
        "Protocol": "Grpc"
      },
      "Console": {
        "Enabled": false
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=notification;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "notification-system-dev",
    "Audience": "notification-system-dev",
    "SigningKey": "dev-only-change-this-signing-key-min-32-chars-000000"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "From": "no-reply@notification.local",
    "EnableSsl": false
  }
}
